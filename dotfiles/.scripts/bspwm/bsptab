# ── Helpers ────────────────────────────────────────────────────────────────── #


def hex_to_rgb(h: str):
    return (int(h[1:3], 16) / 255.0, int(h[3:5], 16) / 255.0, int(h[5:7], 16) / 255.0)


def hex_to_pixel(h: str) -> int:
    return (int(h[1:3], 16) << 16) | (int(h[3:5], 16) << 8) | int(h[5:7], 16)


def bspc(*args) -> str:
    """Run a bspc command and return stdout."""
    try:
        result = subprocess.run(
            ["bspc"] + list(args),
            capture_output=True, text=True, timeout=2,
        )
        return result.stdout.strip()
    except Exception:
        return ""


def bspc_ok(*args) -> bool:
    """Run a bspc command and return True if it succeeded."""
    try:
        result = subprocess.run(
            ["bspc"] + list(args),
            capture_output=True, text=True, timeout=2,
        )
        return result.returncode == 0
    except Exception:
        return False


def get_focused_wid() -> int:
    s = bspc("query", "-N", "-n", "focused")
    if not s:
        return 0
    return int(s, 16)


def get_neighbor_wid(direction: str) -> int:
    s = bspc("query", "-N", "-n", direction)
    if not s:
        return 0
    return int(s, 16)


def wid_hex(wid: int) -> str:
    return f"0x{wid:08X}"


