# Tabbed windows (i3-style tabs via bsptab daemon)
# Add neighbor in direction to focused tab group
super + t; {h,j,k,l}
    bsptab add {west,south,north,east}
# Remove active tab from group
super + t; r
    bsptab remove
# Create tab group from focused window
super + t; t
    bsptab create
# Switch tabs
super + t; {n,p}
    bsptab {next,prev}
# Focus tab by number
super + t; {1-9}
    bsptab focus {1-9}
# Close active tab
super + t; q
    bsptab close
# set the window state
