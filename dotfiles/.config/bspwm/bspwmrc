#! /bin/sh
USERNAME=$(echo $USER)
# Startup #{{{
"/home/${USERNAME}/.config/eww/launch_bar.sh" & \
    "/home/${USERNAME}/.config/bspwm/bsp_configure_monitors.sh" & \

# Start sxhkd only if not already running, so `bspc wm -r` (which re-runs this
# file) does not stack duplicate hotkey daemons. Duplicates fire every keybind
# N times, multiplying bspc commands and amplifying event bursts.
pgrep -x sxhkd >/dev/null || sxhkd &

# Start bsptab daemon for i3-style tabbed windows
pkill -f "bsptab daemon" 2>/dev/null
"/home/${USERNAME}/.scripts/bspwm/bsptab" daemon &
#}}}
# /home/diamond/.config/polybar/launch.sh &

# Sizing #{{{
bspc config window_gap                    10
bspc config border_width                  3

# top/bottom padding managed by launch_bar.sh based on bar position
bspc config left_padding                  0
bspc config right_padding                 0
#}}}

# Settings #{{{

#disable apps from focusing to themselves when they finish loading
bspc config ignore_ewmh_focus             true

bspc config single_monocle                false
bspc config split_ratio                   0.50
bspc config borderless_monocle            true
bspc config gapless_monocle               true

bspc config right_monocle_padding          5
bspc config left_monocle_padding           5
bspc config top_monocle_padding            8
bspc config bottom_monocle_padding         8

# Focus
bspc config focus_by_distance             true
bspc config focus_follows_pointer         true
bspc config click_to_focus                false

bspc config history_aware_focus           true
bspc config remove_unplugged_monitors     true
bspc config remove_disabled_monitors      true
bspc config merge_overlapping_monitors    true
bspc config pointer_modifier mod4

# Pointer
bspc config pointer_action1 move
bspc config pointer_action2 resize_side
bspc config pointer_action3 resize_corner
#}}}

# Coloring #{{{
bspc config normal_border_color		      "#4c566a"
bspc config active_border_color	        "#1e1e1e"
bspc config focused_border_color	      "#5e81ac"
bspc config presel_feedback_color	      "#5e81ac"
bspc config urgent_border_color 	      "#dd2727"
#}}}

# Rules #{{{
#polybar hidden when fullscreen for vlc, youtube, mpv ...
#find out the name of your monitor with xrandr
xdo below -t $(xdo id -n root) $(xdo id -a /home/diamond/.config/polybar_ex/launch.sh)

bspc rule -a electron state=floating

#bspc rule -a Gimp desktop='^8' state=floating follow=on
#bspc rule -a Chromium desktop='^2'
#bspc rule -a mplayer2 state=floating
#bspc rule -a Kupfer.py focus=on
#bspc rule -a Screenkey manage=off
#}}}

