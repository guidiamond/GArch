# Custom widget to delete a word or a single non-alphanumeric character
backward-kill-alnum-word() {
  # Check if the character to the left of the cursor is a letter or number
  if [[ ${BUFFER[CURSOR]} =~ '[[:alnum:]]' ]]; then
    # If it is, delete backwards until a non-alphanumeric char is found
    while [[ ${BUFFER[CURSOR]} =~ '[[:alnum:]]' && $CURSOR -gt 0 ]]; do
      zle .backward-delete-char
    done
  else
    # Otherwise (if it's a symbol or space), just delete that single character
    zle .backward-delete-char
  fi
}

# Register the function as a Zle (Zsh Line Editor) widget
zle -N backward-kill-alnum-word

# Bind the Alt+Backspace key sequence to your new widget
bindkey '^[^?' backward-kill-alnum-word
