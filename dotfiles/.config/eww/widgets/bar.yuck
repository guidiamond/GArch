;; Main bar layout — includes all sub-widgets and defines shared widgets.
;; Per-monitor windows are generated by launch_bar.sh into _monitors.yuck.

(include "./widgets/bar/workspaces.yuck")
(include "./widgets/bar/window_title.yuck")
(include "./widgets/bar/clock.yuck")
(include "./widgets/bar/system.yuck")
(include "./widgets/bar/system_overlay.yuck")
(include "./widgets/bar/controls.yuck")
(include "./widgets/bar/power.yuck")
(include "./widgets/bar/media.yuck")

;; Bar content — three sections: left, center, right
;; ws-data is a per-monitor deflisten variable passed from the generated window.
(defwidget bar-content [ws-data monitor bright-data window-title-data]
  (centerbox :class "bar-content ${sys-data.cpu >= 90 || sys-data.memory.percent >= 90 ? 'bar-res-critical' : sys-data.cpu >= 75 || sys-data.memory.percent >= 75 ? 'bar-res-warning' : ''}" :orientation "horizontal"
    ;; Left: workspaces + window title
    (box :class "bar-left" :orientation "horizontal" :space-evenly false :spacing 8 :halign "start"
      (box :class "module-group"
        (workspaces :ws-data ws-data :monitor monitor))
      (box :class "separator" "")
      (window-title :title-data window-title-data))
    ;; Center: media player
    (box :class "bar-center" :halign "center"
      (media-player))
    ;; Right: controls + clock + power
    (box :class "bar-right" :orientation "horizontal" :space-evenly false :spacing 12 :halign "end"
      (box :class "module-group"
        (controls :monitor monitor :bright-data bright-data))
      (box :class "separator" "")
      (box :class "module-group systray-group"
        (systray :class "systray" :icon-size 16 :orientation "horizontal" :spacing 6))
      (box :class "separator" "")
      (clock)
      (box :class "separator" "")
      (box :class "module-group"
        (power-button)))))

;; Power menu overlay (opened/closed dynamically by power_toggle.sh on focused monitor)
(defwindow power-popup
           :geometry (geometry :x "16px"
                               :y "48px"
                               :anchor "top right")
           :stacking "overlay"
           :windowtype "dialog"
           :wm-ignore true
  (power-menu))
